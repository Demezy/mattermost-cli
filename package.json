{
  "name": "mattermost-cli",
  "version": "0.4.0",
  "description": "CLI tool for interacting with Mattermost servers via the REST API",
  "type": "module",
  "bin": {
    "mm": "./bin/mm.ts",
    "mattermost-cli": "./bin/mm.ts"
  },
  "scripts": {
    "dev": "bun run bin/mm.ts",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit",
    "postinstall": "bun2nix -o bun.nix"
  },
  "dependencies": {
    "citty": "^0.2.1"
  },
  "devDependencies": {
    "@mattermost/types": "^11.4.0",
    "@types/bun": "latest",
    "bun2nix": "^2.0.8",
    "typescript": "^5.7.0"
  }
}
